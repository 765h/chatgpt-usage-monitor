{
  "manifest_version": 3,
  "name": "Claude Usage Bridge",
  "version": "1.0",
  "description": "Claude使用量をローカルのトレイアプリに送る",
  "permissions": ["alarms"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://localhost:9876/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
